# Copy to apps/web/.env.local. Values starting with VITE_ are public: they are baked into
# the client bundle, so never put secrets here (SR-01).

# Base URL of the AI proxy (apps/ai-proxy), e.g. http://localhost:3001 or
# https://your-proxy.vercel.app. Leave empty to always use the offline rule-based summary.
# The production build also adds this origin to the CSP connect-src.
VITE_AI_PROXY_URL=
