{
  "name": "@evm/desktop",
  "productName": "EVM Cost Tracker",
  "version": "0.7.0",
  "private": true,
  "description": "EVM Cost Tracker desktop app (Electron shell around the web build).",
  "author": "Rai Sardar Ahmed",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs --with-web",
    "dist": "npm run build && electron-builder --win nsis --config electron-builder.yml",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@evm/core": "*",
    "@evm/platform": "*",
    "@google/genai": "^2.32.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "zod": "^4.6.7"
  }
}
