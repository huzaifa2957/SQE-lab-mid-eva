# Copy to .env (repo root) and fill in. Never commit .env (SR-01).
# Used by apps/ai-proxy only — these values never reach the browser.
# On Replit put them in Secrets; on Vercel in Project → Settings → Environment Variables.

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required. Pick a model name from the list in Google AI Studio (a current "Flash"
# model is a good free-tier choice). The proxy refuses to start without it.
GEMINI_MODEL=

# Comma-separated origins allowed to call the proxy (scheme + host + port, no path).
ALLOWED_ORIGINS=http://localhost:5173

# Port for the local / Replit server (default 3001).
PORT=3001

# The web app's settings live in apps/web/.env.example.
