# Copy to .env and fill in. Never commit .env (SR-01).

# apps/ai-proxy (server-side only — never exposed to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ALLOWED_ORIGINS=http://localhost:5173

# apps/web (public, baked into the client bundle — no secrets here)
VITE_AI_PROXY_URL=http://localhost:3001
